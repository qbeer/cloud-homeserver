# Local secrets only
.env

# data/ is a config snapshot generated by scripts/sync.sh --config.
# The exact file/dir list lives in scripts/sync_manifest.txt; anything not
# listed there must not be committed (DBs, logs, caches, certs, secrets).
# Everything under data/ is ignored on purpose; the manifest files are added
# with `git add -f` by `scripts/sync.sh --config`.
data/*